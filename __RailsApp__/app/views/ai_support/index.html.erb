<div class="ah-container">
  <aside class="ah-sidebar">
    <p class="ah-sidebar-title">Agent Events</p>
    <div id="ah-events" class="ah-events"></div>
  </aside>

  <div class="ah-main">
    <div class="ah-card">
      <div class="ah-logo">&#x26A1;</div>
      <h1 class="ah-title">ActiveHarness AI Support</h1>
      <p class="ah-subtitle">Ask anything &mdash; powered by ActiveHarness agents</p>

      <form id="ah-form" class="ah-form">
        <textarea
          id="ah-input"
          class="ah-textarea"
          placeholder="What is your return policy?"
          rows="3"
          autocomplete="off"
        >Hello!</textarea>
        <button type="submit" class="ah-submit" id="ah-btn">Ask</button>
      </form>

      <div id="ah-result" class="ah-result">
        <div id="ah-output" class="ah-output"><span class="ah-placeholder">Response will appear here&hellip;</span></div>
        <div id="ah-meta" class="ah-meta"></div>
      </div>

      <a href="/" class="ah-back">&larr; Back</a>
    </div>
  </div>
</div>
