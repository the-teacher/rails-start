<% content_for :styles do %>
  <%= stylesheet_link_tag "ai_tribunals" %>
<% end %>

<div class="ah-tribunal-page">

  <div class="ah-tribunal-hero">
    <div class="ah-cases-logo">&#x1F6E1;&#xFE0F;</div>
    <h1 class="ah-tribunal-title">Tribunal 03 &mdash; Content Safety</h1>
    <p class="ah-tribunal-subtitle">
      Two different approaches to the same question, run in parallel: a classic
      prompted chat model (<code>ToxicityRequest</code>) vs Jev, a specialized
      evaluation model (<code>JevRequest</code>, via Vercel AI Gateway).
      Both must agree for the verdict to be <strong>safe</strong>.
    </p>
  </div>

  <%# ── Input ──────────────────────────────────────────────────────────────── %>
  <form id="ah-tribunal-form" class="ah-tribunal-form">
    <textarea
      id="ah-tribunal-input"
      class="ah-tribunal-textarea"
      placeholder="Type a message to evaluate…"
      rows="3"
      autocomplete="off"
    >Please could you help me with my order?</textarea>
    <button type="submit" id="ah-tribunal-btn" class="ah-tribunal-submit">Evaluate</button>
  </form>

  <%# ── Two verdict panels ─────────────────────────────────────────────────── %>
  <div class="ah-tribunal-panels" id="ah-tribunal-panels">
    <div class="ah-tribunal-panel" id="ah-panel-text">
      <div class="ah-panel-badge" id="ah-badge-text"></div>
      <div class="ah-panel-model" id="ah-model-text">ToxicityRequest</div>
      <div class="ah-panel-result" id="ah-result-text">&mdash;</div>
      <p class="ah-panel-reason" id="ah-reason-text"></p>
      <div class="ah-panel-meta">
        <span id="ah-tokens-text"></span>
        <span id="ah-time-text"></span>
        <span id="ah-cost-text"></span>
      </div>
    </div>

    <div class="ah-tribunal-panel" id="ah-panel-jev">
      <div class="ah-panel-badge" id="ah-badge-jev"></div>
      <div class="ah-panel-model" id="ah-model-jev">JevRequest (typesafe-ai/jev)</div>
      <div class="ah-panel-result" id="ah-result-jev">&mdash;</div>
      <p class="ah-panel-reason" id="ah-reason-jev"></p>
      <div class="ah-panel-meta">
        <span id="ah-tokens-jev"></span>
        <span id="ah-time-jev"></span>
        <span id="ah-cost-jev"></span>
      </div>
    </div>
  </div>

  <%# ── Final verdict ──────────────────────────────────────────────────────── %>
  <div class="ah-tribunal-verdict" id="ah-final-verdict">
    <div class="ah-verdict-label">Verdict</div>
    <div class="ah-verdict-value" id="ah-verdict-value">&mdash;</div>
    <div class="ah-verdict-time" id="ah-verdict-time"></div>
    <div class="ah-verdict-time" id="ah-verdict-cost"></div>
  </div>

  <div class="ah-tribunal-nav">
    <%= link_to "&larr; T–02: Lifecycle".html_safe, ai_tribunals_politeness_lifecycle_path, class: "ah-cases-back" %>
    <%= link_to "Cases &rarr;".html_safe, ai_cases_path, class: "ah-cases-back" %>
  </div>

</div>

<% content_for :scripts do %>
  <%= javascript_include_tag "ai_tribunal_safety" %>
<% end %>
