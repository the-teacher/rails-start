<div class="ah-container ah-container--centered">
  <div class="ah-card">
    <div class="ah-logo">&#x1F5BC;&#xFE0F;</div>
    <h1 class="ah-title">Case 07 &mdash; Image Generation</h1>
    <p class="ah-subtitle">
      Describe an image and <code>openai/gpt-5-image-mini</code> will draw it via OpenRouter.
    </p>

    <form id="ah-form" class="ah-form">
      <textarea
        id="ah-input"
        class="ah-textarea"
        placeholder="Describe the image… e.g. a red apple on a white table"
        rows="2"
        autocomplete="off"
      >a tiny kawaii robot waving hello, flat illustration, pastel colors</textarea>
      <button type="submit" class="ah-submit" id="ah-btn">Generate</button>
    </form>

    <div id="ah-result" class="ah-result">
      <div id="ah-image-wrap" class="ah-image-wrap">
        <span class="ah-placeholder">Image will appear here&hellip;</span>
      </div>
      <div id="ah-meta" class="ah-meta"></div>
      <div id="ah-tokens" class="ah-tokens"></div>
      <div id="ah-cost" class="ah-cost"></div>
    </div>

    <%= render "nav",
         back_label: "&larr; Case 06",
         back_path:  ai_agents_memory_path,
         next_label: "Cases &rarr;",
         next_path:  ai_cases_path %>
  </div>
</div>

<% content_for :scripts do %>
  <%= javascript_include_tag "ai_agent_image" %>
<% end %>
